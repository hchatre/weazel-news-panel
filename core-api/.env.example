# Copy to core-api/.env (never commit .env). Generate secrets with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
WEAZEL_ENVIRONMENT=production
WEAZEL_DATABASE_URL=postgresql+psycopg2://weazel:CHANGE_ME@127.0.0.1:5432/weazel
WEAZEL_AUTH_MODE=fivem
WEAZEL_JWT_SECRET=
WEAZEL_BRIDGE_SECRET=
WEAZEL_STORAGE_DIR=D:/weazel/storage
WEAZEL_CORS_ORIGINS=http://localhost:3000
WEAZEL_PUBLIC_BASE_URL=http://localhost:3000
# AI is off unless set: none | ollama | openai_compat
WEAZEL_AI_PROVIDER=none
# Discord webhook: environment only, never committed
WEAZEL_DISCORD_WEBHOOK_PUBLISH=
