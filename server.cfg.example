# Add to your server.cfg. Never commit your real values.
# Create NEW webhooks in Discord (Channel settings > Integrations > Webhooks). The old ones were published
# in the public repository and must be deleted.

set weazel_webhook_publish_1 "https://discord.com/api/webhooks/REPLACE_ID/REPLACE_TOKEN"
set weazel_webhook_publish_2 "https://discord.com/api/webhooks/REPLACE_ID/REPLACE_TOKEN"
set weazel_webhook_log       "https://discord.com/api/webhooks/REPLACE_ID/REPLACE_TOKEN"

# 1 (default) = any player can read, like and comment (previous behaviour). 0 = journalists only.
set weazel_public_access 1
# 1 = an editor cannot approve their own pending article. Default 0 keeps the previous behaviour.
set weazel_block_self_approval 0

ensure oxmysql
ensure qb-core
ensure qb-weazel-ui   # use your real resource folder name

# --- Weazel web platform bridge (optional) -------------------------------------------------------------
# Must be at least 32 random characters and identical to WEAZEL_BRIDGE_SECRET on the API. Never commit the real value.
set weazel_api_url "http://127.0.0.1:8000"
set weazel_bridge_secret "REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS"
